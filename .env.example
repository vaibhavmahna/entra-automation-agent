# Sandbox tenant app registration (Entra ID -> App registrations)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Azure OpenAI - judgment layer (gpt-4.1-mini deployment)
# Auth is via DefaultAzureCredential (az login session), no key needed
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Separate app registration for the mailbox connector (Mail.ReadWrite,
# scoped via an Exchange Application Access Policy to one mailbox only -
# see README for why this needs its own registration and policy)
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_MAILBOX=
